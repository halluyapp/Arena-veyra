{
  "name": "veyra-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform android",
    "prebuild": "EXPO_TV=1 expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "react": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-2",
    "@react-native-tvos/config-tv": "0.1.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-file-system": "~19.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react-native-video": "6.19.3",
    "react-native-svg": "15.12.1",
    "react-native-qrcode-svg": "6.3.21",
    "@kesha-antonov/react-native-background-downloader": "4.7.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10"
  }
}
